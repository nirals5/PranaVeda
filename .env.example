# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Required for ElevenLabs text-to-speech voice synthesis.
# Get your key at https://elevenlabs.io
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# ELEVENLABS_VOICE_ID: The specific voice to use for speech synthesis.
# Find voice IDs in your ElevenLabs voice library.
ELEVENLABS_VOICE_ID="MY_ELEVENLABS_VOICE_ID"

# VITE_GOOGLE_CLIENT_ID: OAuth 2.0 Web client ID for the Google connectors: Calendar
# (read-only free/busy) and Google Health (read-only sleep and heart metrics; enable
# the Google Health API on the same Cloud project). Create one at https://console.cloud.google.com/apis/credentials
# and add your site origin under "Authorized JavaScript origins". Optional — without
# it the Google options show as "not set up".
VITE_GOOGLE_CLIENT_ID=""
