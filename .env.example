# ANTHROPIC_API_KEY: Required for Amrita (chat, rituals, daily insight).
# Get a key at https://console.anthropic.com. Without it the app runs, and
# Amrita answers with a short "resting" message instead of real guidance.
ANTHROPIC_API_KEY=""

# ELEVENLABS_API_KEY: Required for ElevenLabs text-to-speech voice synthesis.
# Get your key at https://elevenlabs.io
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# ELEVENLABS_VOICE_ID: The specific voice to use for speech synthesis.
# Find voice IDs in your ElevenLabs voice library.
ELEVENLABS_VOICE_ID="MY_ELEVENLABS_VOICE_ID"

# ALEXA_SKILL_ID: The Alexa skill's ID (amzn1.ask.skill.…), from the Alexa
# developer console. Optional, but set it in production: /api/alexa then
# answers only this skill. Every request is still checked as signed by Amazon.
ALEXA_SKILL_ID=""
# ALEXA_SKILL_URL: the skill's public Amazon page, once Amazon has certified and
# published it (https://www.amazon.<tld>/…). While unset, the Smart assistants
# card in the apps and on the website leaves Alexa out.
ALEXA_SKILL_URL=""
# Alexa account linking (README, "Linking an account"). ALEXA_OAUTH_CLIENT_ID
# and _SECRET are made up here (the secret long and random) and typed into the
# skill's Account Linking settings; Amazon uses them at /api/oauth/token.
# ALEXA_VENDOR_ID (optional) accepts only your developer account's redirect
# addresses (the last part of the "Alexa Redirect URLs" Amazon lists).
ALEXA_OAUTH_CLIENT_ID=""
ALEXA_OAUTH_CLIENT_SECRET=""
# ALEXA_VENDOR_ID=""
# Alexa notifications: the skill's own Client ID and Client Secret, from the
# skill's Build → Permissions page ("Alexa Skill Messaging"). ALEXA_EVENTS_STAGE
# is "development" (only your own Echo) until the skill is certified, then "live".
ALEXA_EVENTS_CLIENT_ID=""
ALEXA_EVENTS_CLIENT_SECRET=""
# ALEXA_EVENTS_STAGE="development"

# VITE_GOOGLE_CLIENT_ID: OAuth 2.0 Web client ID for the Google connectors: Calendar
# (read-only free/busy) and Google Health (read-only sleep and heart metrics; enable
# the Google Health API on the same Cloud project). Create one at https://console.cloud.google.com/apis/credentials
# and add your site origin under "Authorized JavaScript origins". Optional — without
# it the Google options show as "not set up".
VITE_GOOGLE_CLIENT_ID=""

# DATABASE_URL: Neon Postgres connection string, used for accounts and sign-in
# (api/auth.ts). Optional — without it the app runs signed-out exactly as before.
# Use a Neon development branch locally, never the production branch.
# After changing db/schema.ts: `npm run db:generate`, then `npm run db:migrate`.
# DATABASE_URL is the direct connection (used for migrations).
# DATABASE_URL_POOLED is the pooled one (host contains "-pooler"), used by the
# running app when set; without it the app falls back to DATABASE_URL.
DATABASE_URL=""
DATABASE_URL_POOLED=""

# AUTH_JWT_SECRET: signs sign-in sessions. At least 32 random characters, e.g.
# from `openssl rand -base64 48`. Use a different value in every environment.
# To rotate: move the old value to AUTH_JWT_SECRET_PREVIOUS and set a new one;
# remove the previous value after 15 minutes, once tokens it signed have expired.
AUTH_JWT_SECRET=""
AUTH_JWT_SECRET_PREVIOUS=""

# VITE_ACCOUNTS_ENABLED: set to "true" to show the optional sign-in panel in
# Profile. Leave unset in production until syncing is built: signing in creates
# an account but does not yet move any data off the device. Also needs
# VITE_GOOGLE_CLIENT_ID, AUTH_JWT_SECRET and DATABASE_URL.
VITE_ACCOUNTS_ENABLED=""

# Google client ids the server accepts sign-in tokens for. The web one defaults
# to VITE_GOOGLE_CLIENT_ID. Without GOOGLE_CLIENT_ID_IOS the server refuses
# sign-ins from the iOS app. Client ids are not secrets (they ship inside the
# apps); this is the iOS app's (bundle id com.pranaveda.app).
GOOGLE_CLIENT_ID_IOS="163737232285-bcks8qr3n3d3a6q01o6h9rm2akn35h8o.apps.googleusercontent.com"
# The Android app's sign-in tokens are issued for the WEB client id (Android's
# Credential Manager requires it), so the server needs nothing extra for them.
# The Android client below (package com.pranaveda.app, debug-key SHA-1) only
# lets Google recognise the app; listing it here is harmless.
GOOGLE_CLIENT_ID_ANDROID="163737232285-n90dtvtf7j2nlslsu0s60rp8v196ninc.apps.googleusercontent.com"

# Sign in with Apple (all from the Apple Developer portal). Optional: without
# VITE_APPLE_SERVICES_ID the Apple button is not shown.
# VITE_APPLE_SERVICES_ID: the Services ID used for web sign-in (e.g. com.example.web).
# APPLE_TEAM_ID, APPLE_KEY_ID, APPLE_PRIVATE_KEY: the Sign in with Apple key
# (.p8 file contents; line breaks may be written as \n). Used only to obtain
# the token Apple requires us to revoke when an account is deleted.
# APPLE_BUNDLE_ID: the iOS app's bundle id (com.pranaveda.app). Without it the
# server refuses the iOS app's Apple sign-ins (ios/README.md).
VITE_APPLE_SERVICES_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
APPLE_BUNDLE_ID=""

# CONNECTIONS_ENC_KEY: encrypts what is kept on the server from elsewhere: Apple's
# token, and saved places and the calendar link when a user keeps them on the
# account. At least 32 random characters; never change it once set.
CONNECTIONS_ENC_KEY=""

# PUBLIC_ASSET_BASE_URL: the site (or, later, CDN) that pose images are served
# from, e.g. https://pranaveda.example. Optional. When set, pose image links in
# Amrita's rituals and in /api/catalog use it, so they work in the iOS and
# Android apps and in saved rituals viewed elsewhere. When unset, rituals keep
# site paths ("/poses/cobra.jpg") and /api/catalog uses the request's address.
PUBLIC_ASSET_BASE_URL=""

# Rate limits (api/_lib/rateLimit.ts). Optional: unset, the built-in limits
# below apply. RATE_LIMITS=off turns limiting off everywhere. Each route's
# limits are "<per minute>/<per day>" per person (or guest network address);
# the day resets at midnight UTC. On Vercel, redeploy after changing these.
# RATE_LIMITS="off"
# RATE_LIMIT_CHAT="10/300"
# RATE_LIMIT_VOICE="30/600"
# RATE_LIMIT_INSIGHT="5/50"
# RATE_LIMIT_COACHING="5/50"
# RATE_LIMIT_CALENDAR="10/300"

# Weather (api/_lib/weather.ts, G14). Vercel's approximate location for the
# request, then Apple WeatherKit's REST API (included with the Apple Developer
# Program, commercial use allowed). It needs a Services ID registered for
# WeatherKit and a key with WeatherKit enabled (developer.apple.com →
# Certificates, IDs & Profiles), plus APPLE_TEAM_ID above. If WeatherKit fails,
# or without these (as in local development), MET Norway stands in (no key;
# commercial use allowed under CC BY 4.0 with credit).
# WEATHERKIT_PRIVATE_KEY is the .p8 file's contents; line breaks may be "\n".
# WEATHER=off turns the lookup off. Locally there is no Vercel location, so a
# fixed place stands in: "<latitude>,<longitude>".
WEATHERKIT_SERVICE_ID=""
WEATHERKIT_KEY_ID=""
WEATHERKIT_PRIVATE_KEY=""
# WEATHER="off"
# WEATHER_TEST_LOCATION="47.6,-122.3"

# Push nudges for the website (api/push.ts). Generate a key pair once with
#   npx web-push generate-vapid-keys
# and keep it: changing it stops every existing subscription. PUSH_TICK_SECRET
# is any long random string, shared with the Cloudflare cron that calls
# /api/push/tick every 15 minutes (cloudflare/push-ticker). Without these,
# the Notifications row falls back to notifications from an open tab.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="https://pranaveda.app"
PUSH_TICK_SECRET=""
