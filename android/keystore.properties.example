# Release signing for Google Play. Copy to keystore.properties (git ignores it)
# and fill in. See README.md, "Release build for Google Play".
#
# The upload key, kept outside the project (and backed up):
storeFile=/Users/you/Keys/pranaveda-upload.jks
keyAlias=upload
storePassword=
# The same as storePassword for keytool's default (PKCS12) keystore:
keyPassword=
