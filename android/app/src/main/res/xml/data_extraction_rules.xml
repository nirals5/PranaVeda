<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: as backup_rules.xml, for cloud backup and for
     moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pranaveda_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pranaveda_session.xml" />
    </device-transfer>
</data-extraction-rules>
