<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Speaking to Amrita. Asked for the first time the microphone is tapped. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The practice in progress as a silent ongoing notification (practice/PracticeNotice.kt);
         asked for once, on the first practice. Promoted: shown as a Live Update on Android 16+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Recovery & Trends: read only, on the phone (health/HealthStore.kt). -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />

    <!-- Spoken guidance and replies use the phone's text-to-speech engine, and
         speaking to Amrita its speech recognition; from Android 11 an app must
         declare that it looks for them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Health Connect, for Android 13 and earlier, where it is a separate app. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".PranaVedaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PranaVeda">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The widgets' links: pranaveda://talk, pranaveda://you, pranaveda://ritual/<id>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="pranaveda" />
            </intent-filter>
            <!-- Long-press the app icon: Talk to Amrita, Start my practice. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- How PranaVeda uses health data: Health Connect links here from its
             permission screen (Android 13 and earlier, and 14 and later). -->
        <activity
            android:name=".health.HealthPrivacyActivity"
            android:exported="true"
            android:label="Your health data in PranaVeda">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".health.HealthPrivacyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Home-screen widgets (widget/Widgets.kt). -->
        <receiver android:name=".widget.TodayWidgetReceiver" android:exported="true" android:label="Today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_widget_info" />
        </receiver>
        <receiver android:name=".widget.WeekWidgetReceiver" android:exported="true" android:label="This week">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/week_widget_info" />
        </receiver>

        <!-- Quick Settings tile: Talk to Amrita (widget/TalkTileService.kt). -->
        <service
            android:name=".widget.TalkTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="Talk to Amrita"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
